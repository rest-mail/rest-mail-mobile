<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  How an archive becomes something App Store Connect will take: `chore ipa`,
  which hands this file to `flutter build ipa` as its export options (the full
  command is in chores.yml; it cannot be quoted here, as an XML comment may not
  hold a double hyphen).

  Signing is left to Xcode (signingStyle automatic): it picks the distribution
  certificate and provisioning profile for this team from the machine doing the
  build. That machine needs to be signed in to the Apple Developer account, so
  this file alone is not enough to release — it only says what kind of export is
  wanted, and holds no secrets.
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>

	<key>teamID</key>
	<string>43UMKXZ8P4</string>

	<key>signingStyle</key>
	<string>automatic</string>

	<key>destination</key>
	<string>export</string>

	<!-- Xcode does not renumber the build: `chore ipa` stamps the build number
	     from the commit count, so a build in TestFlight names its commit. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>

	<!-- Symbols go with the build so crash reports from TestFlight and the store
	     come back symbolicated. -->
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
