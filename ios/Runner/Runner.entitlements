<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- https://rest-mail.com/setup#token=… opens the app, not Safari. Apple
	     checks https://rest-mail.com/.well-known/apple-app-site-association,
	     which the website repository serves. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:rest-mail.com</string>
	</array>
</dict>
</plist>
